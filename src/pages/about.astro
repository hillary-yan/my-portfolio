---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const paragraphs = [
  `I'm Gigi, an Interactive Media Designer based in Toronto, specializing in brand design, digital experiences, and marketing communications. Much of my work is with educational institutions, developing visual identities and applying them across print, websites, and marketing materials. My projects span North America, China, and the Middle East.`,
  `Over the past few years, I've contributed to branding projects for several educational institutions, alongside freelance projects for clients such as T&T Supermarket and Golf Canada. I’m particularly interested in how a visual identity works across different formats, from websites and social media to advertising, events, and print.`,
  `My role also includes marketing, from promoting programs to planning events that connect students with clients. Alongside graphic design, photo editing, and video production, I use HubSpot for email marketing and Claude to support content planning and web development.`,
  `I enjoy analyzing problems, planning the path forward, and getting things done step by step. Understanding what a team needs, deciding what to prioritize, and following through on the details are all part of how I approach design.`,
];
---

<BaseLayout title="About – Ge Yan" showNav={false}>
  <div class="min-h-screen">
    <section class="w-full max-w-xl mx-auto px-6 pb-24">
      <SiteHeader avatarImage="/2.jpeg" />

      <main class="pl-[1.7rem]">
        <div class="space-y-4">
          {paragraphs.map((p) => (
            <p class="text-sm text-gray-700 leading-6 font-body">{p}</p>
          ))}
        </div>

        <p class="mt-10">
          <a
            href="/contact"
            class="text-xs text-gray-500 hover:text-gray-900 font-body focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 rounded-sm"
          >
            Contact →
          </a>
        </p>
      </main>
    </section>
  </div>
</BaseLayout>
