---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const paragraphs = [
  `I'm Gege, an Interactive Media Designer based in Toronto, specializing in brand design, digital experiences, and marketing communications. I help educational institutions build clear, consistent, and scalable brand experiences across print, digital, and marketing platforms, with projects spanning North America, China and the Middle East.`,
  `Over the past few years, I've contributed to branding projects for several educational institutions, as well as projects for brands such as T&T Supermarket and Golf Canada. These experiences have shaped my focus: helping established brands build clearer, more consistent, and scalable visual systems, then extending them across websites, social media, advertising, events, and print materials.`,
  `My work goes beyond design execution. From graphic design, photo editing, and video production to HubSpot marketing automation and using AI tools such as Claude and OpenClaw to support content planning and workflow optimization, I'm always exploring how creativity, technology, and efficiency can work together to serve real business goals.`,
  `I'm not someone who likes to overtalk. I enjoy analyzing problems, planning the path forward, and getting things done step by step. To me, design is not decoration — it is a way to solve problems. Truly valuable design is not just about creating beautiful work, but about finding direction within complexity and helping teams and brands grow.`,
];
---

<BaseLayout title="About – Ge Yan" showNav={false}>
  <div class="min-h-screen">
    <section class="w-full max-w-xl mx-auto px-6 pb-24">
      <SiteHeader avatarImage="/1.jpeg" />

      <main class="pl-[1.7rem]">
        <div class="space-y-4">
          {paragraphs.map((p) => (
            <p class="text-sm text-gray-700 leading-6 font-body">{p}</p>
          ))}
        </div>

        <p class="mt-10">
          <a
            href="/contact"
            class="text-xs text-gray-500 hover:text-gray-900 font-body focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 rounded-sm"
          >
            Contact →
          </a>
        </p>
      </main>
    </section>
  </div>
</BaseLayout>
