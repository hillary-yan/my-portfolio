---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';

// 1. 先定义类型
type SummaryPart = { text: string; href?: string };
type Project = {
  title: string;
  meta: string;
  /** 整段纯文字，或「文本片段 + 可选链接」拼成一段 */
