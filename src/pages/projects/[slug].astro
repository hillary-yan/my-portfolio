// 3. Astro 静态路径函数
export async function getStaticPaths() {
  // 直接根据上面定义的 projects 的 key 生成路径
  const projectKeys = ['project-one', 'project-two', 'project-three', 'project-four', 'project-five', 'project-six']; 
  return projectKeys.map((slug) => ({ params: { slug } }));
}

// 4. 获取当前页面的数据
const { slug } = Astro.params;
const project = projects[slug as string];

// 如果找不到项目，返回 404 状态
if (!project) {
  Astro.response.status = 404;
}

/** 分段 summary 用 HTML 输出（避免 .map 里混合字符串与标签时被序列化成 [object Object]） */
function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function isVideoSrc(src: string, type?: string): boolean {
  if (type === 'video') return true;
  return /\.(mp4|mov|webm|ogg)(\?|$)/i.test(src);
}

function summaryPartsToHtml(parts: SummaryPart[]): string {
  const linkClass = 'underline underline-offset-2 text-gray-900 hover:text-gray-600';
  return parts
    .map((p) =>
      p.href
        ? `<a href="${escapeHtml(p.href)}" class="${linkClass}" target="_blank" rel="noopener noreferrer">${escapeHtml(p.text)}</a>`
        : escapeHtml(p.text),
    )
    .join('');
}
---

<BaseLayout title={project ? `${project.title} – Portfolio` : 'Not found – Portfolio'} showNav={false}>
  <div class="min-h-screen">
    <section class="w-full max-w-xl mx-auto px-6 pb-24">
      <SiteHeader />

      {project ? (
        <main>
          <div class="mt-2">
            <a href="/" class="text-xs text-gray-500 hover:text-gray-900">← Back</a>
          </div>

          <header class="mt-8">
            <h1 class="text-sm font-medium text-gray-900">{project.title}</h1>
            <p class="mt-2 text-xs text-gray-500">{project.meta}</p>
            {typeof project.summary === 'string' ? (
              <p class="mt-4 text-sm text-gray-700 leading-6">{project.summary}</p>
            ) : (
              <p class="mt-4 text-sm text-gray-700 leading-6" set:html={summaryPartsToHtml(project.summary)} />
            )}
          </header>

          {project.toggles && project.toggles.length > 0 && (
            <WorkToggles toggles={project.toggles} />
          )}

          {project.sections.length > 0 && (
          <div class="mt-10 space-y-12">
            {project.sections.map((s) => (
              <section class="space-y-4">
                <h2 class="text-xs tracking-[0.18em] uppercase text-gray-500">{s.heading}</h2>
                <div class="space-y-3">
                  {s.body.map((p) => (
                    <p class="text-sm text-gray-800 leading-6">{p}</p>
                  ))}
                </div>

                {s.media && (
  <div class="space-y-4 pt-2">
    {s.media.map((m) =>
      m.type === 'iframe' ? (
        <div class="space-y-3">
          <figure class="rounded-2xl bg-white overflow-hidden border border-gray-200">
            <div class="site-embed">
              <iframe
                src={m.src}
                title={m.alt}
                loading="lazy"
                sandbox="allow-scripts allow-same-origin"
              />
            </div>
          </figure>
          <a
            href={m.src}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-gray-500 hover:text-gray-900"
          >
            Open live template →
          </a>
        </div>
      ) : (
      <figure
        class:list={[
          'rounded-2xl bg-white overflow-hidden',
          { 'border border-gray-200': !m.borderless },
        ]}
      >
        {isVideoSrc(m.src, m.type) ? (
          <video
            src={m.src}
            class="w-full h-auto block"
            controls
            preload="metadata"
          >
            Sorry, your browser doesn’t support embedded videos.
          </video>
        ) : (
          <img
            src={m.src}
            alt={m.alt}
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
          />
        )}
      </figure>
      )
    )}
  </div>
)}
              </section>
            ))}
          </div>
          )}
        </main>
      ) : (
        <div>
          <p class="text-sm text-gray-700">Project not found.</p>
          <a href="/" class="text-sm underline underline-offset-4">Go home</a>
        </div>
      )}

      <SiteFooter />
    </section>
  </div>
</BaseLayout>

<style>
  .site-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0c0c0c;
  }

  .site-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    height: 800px;
    border: 0;
    transform-origin: top left;
  }
</style>

<script>
  function sizeSiteEmbeds() {
    document.querySelectorAll('.site-embed').forEach((el) => {
      const iframe = el.querySelector('iframe');
      if (!(el instanceof HTMLElement) || !(iframe instanceof HTMLIFrameElement)) return;
      const scale = el.clientWidth / 1280;
      iframe.style.transform = `scale(${scale})`;
    });
  }

  sizeSiteEmbeds();
  window.addEventListener('resize', sizeSiteEmbeds);
</script>