---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WorkToggles from '../../components/WorkToggles.astro';

// 1. 先定义类型
type SummaryPart = { text: string; href?: string };
type MediaItem = {
  type?: 'image' | 'video' | 'iframe';
  src: string;
  alt: string;
  borderless?: boolean;
};
type ToggleMediaItem = {
  type?: 'image' | 'video' | 'text' | 'heading';
  src?: string;
  alt?: string;
  text?: string;
  borderless?: boolean;
};
type Project = {
  title: string;
  meta: string;
  /** 整段纯文字，或「文本片段 + 可选链接」拼成一段 */
  summary: string | SummaryPart[];
  sections: {
    heading: string;
    body: string[];
    media?: MediaItem[];
  }[];
  /** Notion-style toggle groups (used on Want more?) */
  toggles?: {
    title: string;
    body?: string[];
    media?: ToggleMediaItem[];
  }[];
};

