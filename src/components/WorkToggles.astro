---
type ToggleMedia = {
  type?: 'image' | 'video' | 'text' | 'heading';
  src?: string;
  alt?: string;
  text?: string;
  borderless?: boolean;
};

type WorkToggle = {
  title: string;
  body?: string[];
  media?: ToggleMedia[];
};

interface Props {
  toggles: WorkToggle[];
}

const { toggles } = Astro.props;

function isVideoSrc(src: string | undefined, type?: string): boolean {
  if (type === 'video') return true;
  return !!src && /\.(mp4|mov|webm|ogg)(\?|$)/i.test(src);
}
---

<div class="mt-10 space-y-0">
  {toggles.map((t) => {
    const paragraphs = t.body && t.body.length > 0 ? t.body : [''];
    const media = t.media ?? [];

    return (
      <details class="group work-toggle">
        <summary class="flex items-start gap-2 cursor-pointer select-none py-2.5 min-h-11">
          <span class="inline-flex items-center justify-center shrink-0 mt-[0.2rem] text-gray-500" aria-hidden="true">
            <svg
              class="size-3.5 transition-transform duration-150 ease-out group-open:rotate-90"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path d="M5.5 3.2v9.6L13 8 5.5 3.2z" />
            </svg>
          </span>
          <span class="text-sm text-gray-900 leading-6">{t.title}</span>
        </summary>

        <div class="pl-6 pb-4 space-y-4">
          {paragraphs.some((p) => p.trim().length > 0) && (
            <div class="space-y-3">
              {paragraphs.map((p) => (
                <p class="text-sm text-gray-800 leading-6">{p}</p>
              ))}
            </div>
          )}

          <div class="space-y-4 pt-1">
            {(media.length > 0 ? media : [{ src: '', alt: `${t.title} work` }]).map((m) =>
              m.type === 'heading' ? (
                m.text ? (
                  <h2 class="text-xs tracking-[0.18em] uppercase text-gray-500">{m.text}</h2>
                ) : null
              ) : m.type === 'text' ? (
                <p class="text-sm text-gray-800 leading-6">{m.text}</p>
              ) : (
                <figure
                  class:list={[
                    'rounded-2xl bg-white overflow-hidden',
                    { 'border border-gray-200': !m.borderless },
                  ]}
                >
                  {m.src ? (
                    isVideoSrc(m.src, m.type) ? (
                      <video src={m.src} class="w-full h-auto block" controls preload="metadata">
                        Sorry, your browser doesn’t support embedded videos.
                      </video>
                    ) : (
                      <img
                        src={m.src}
                        alt={m.alt ?? ''}
                        class="w-full h-auto block"
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  ) : (
                    <div class="w-full min-h-[12rem] bg-white" aria-hidden="true" />
                  )}
                </figure>
              ),
            )}
          </div>
        </div>
      </details>
    );
  })}
</div>

<style>
  .work-toggle > summary {
    list-style: none;
  }

  .work-toggle > summary::-webkit-details-marker {
    display: none;
  }

  .work-toggle[open] svg {
    transform: rotate(90deg);
  }
</style>
